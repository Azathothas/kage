{
 "search.web.pkgforge.dev": {
  "openapi": "3.1.0",
  "info": {
   "title": "search: web search, brokered",
   "version": "b39f3ad27617"
  },
  "paths": {
   "/search": {
    "get": {
     "operationId": "search_get",
     "x-route-id": "search:get",
     "parameters": [
      {
       "name": "q",
       "in": "query",
       "required": true,
       "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
       }
      },
      {
       "name": "count",
       "in": "query",
       "required": false,
       "schema": {
        "type": "integer",
        "minimum": 1,
        "default": 10
       }
      },
      {
       "name": "freshness",
       "in": "query",
       "required": false,
       "schema": {
        "type": "string",
        "enum": [
         "day",
         "week",
         "month",
         "year"
        ]
       }
      },
      {
       "name": "include_domains",
       "in": "query",
       "required": false,
       "schema": {
        "type": "string"
       }
      },
      {
       "name": "exclude_domains",
       "in": "query",
       "required": false,
       "schema": {
        "type": "string"
       }
      },
      {
       "name": "raw",
       "in": "query",
       "required": false,
       "schema": {
        "type": "string",
        "enum": [
         "true",
         "false",
         "1",
         "0"
        ]
       }
      },
      {
       "name": "provider",
       "in": "query",
       "required": false,
       "schema": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
       }
      },
      {
       "name": "rank",
       "in": "query",
       "required": false,
       "schema": {
        "type": "string",
        "enum": [
         "reranked",
         "provider"
        ],
        "default": "reranked"
       }
      }
     ]
    }
   }
  }
 },
 "read.web.pkgforge.dev": {
  "openapi": "3.1.0",
  "info": {
   "title": "read: a page as Markdown",
   "version": "6abd733c92f0"
  },
  "paths": {
   "/": {
    "get": {
     "operationId": "read_query",
     "x-route-id": "read-query",
