   },
   "/save": {
    "post": {
     "operationId": "save",
     "x-route-id": "save",
     "parameters": [
      {
       "name": "url",
       "in": "query",
       "required": true,
       "schema": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
       }
      }
     ]
    }
   },
   "/save/{job}": {
    "get": {
     "operationId": "save_status",
     "x-route-id": "save-status"
    },
    "parameters": [
     {
      "name": "job",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
      }
     }
    ]
   }
  },
  "components": {
   "parameters": {
    "query.url": {
     "name": "url",
     "in": "query",
     "required": true,
     "schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
     }
    },
    "query.provider": {
     "name": "provider",
     "in": "query",
     "required": false,
     "schema": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
     }
    }
   }
  }
 }
}
